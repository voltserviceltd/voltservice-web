# Copy to .env.local for local development. Never commit .env.local (already gitignored).
# In Cloud Build / Cloud Run, these are supplied as build-args / --set-env-vars
# (see cloudbuild.yaml), and secrets should come from Secret Manager, not this file.

# Absolute site URL, used for metadata (canonical/OG), sitemap.xml, robots.txt.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# reCAPTCHA Enterprise site key (public). Not consumed until the inquiry form
# lands (Phase 2) — leave blank until the key is created in the
# voltserviceltd-8b1cc GCP project under Security > reCAPTCHA Enterprise.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Only needed to override the project used for server-side GCP calls (e.g.
# reCAPTCHA Enterprise assessment creation, Firestore) during local dev.
# On Cloud Run this is set automatically (GOOGLE_CLOUD_PROJECT) — do not set
# GCP_PROJECT_ID in production.
GCP_PROJECT_ID=voltserviceltd-8b1cc
